# Copy to .env for local dev:  cp env.example .env
#
# The resume PDF is served from an unguessable URL. Generate your own token:
#   openssl rand -hex 16
# Without RESUME_TOKEN set, the resume route returns 404.
RESUME_TOKEN=

# Path to the PDF. Gitignored — the file must never be committed to this
# public repo. See docs/adr/0001-private-resume-link.md.
RESUME_PATH=private/resume.pdf
